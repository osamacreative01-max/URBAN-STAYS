# ─────────────────────────────────────────────────────────────────────────────
# URBAN STAYS — environment variables
#
# Copy this file to ".env.local" for local development.
# On the live site these live in Vercel → Project → Settings → Environment
# Variables. Nothing here is ever committed to git (.env* is git-ignored).
#
# Full instructions: HANDOVER.md → "Making the contact form send email"
# ─────────────────────────────────────────────────────────────────────────────

# 1. WHERE THE SITE LIVES (optional)
#    Defaults to https://www.urbanstaysandshuttles.co.za if unset.
NEXT_PUBLIC_SITE_URL=https://www.urbanstaysandshuttles.co.za

# 2. CONTACT FORM DELIVERY — pick ONE of the two providers below.
#    If neither is set, the contact form shows an honest error and a WhatsApp
#    fallback instead of pretending the message was sent.

# --- Option A: Resend (recommended) — https://resend.com --------------------
# Create a free account, verify your email address, then create an API key.
RESEND_API_KEY=

# Who receives website enquiries (comma-separate several addresses).
CONTACT_EMAIL_TO=enquiries@urbanstaysandshuttles.co.za
CONTACT_EMAIL_CC=tirzahdlamini@gmail.com

# Sender shown in the inbox. "onboarding@resend.dev" works immediately for
# testing (delivers only to your verified Resend address). Once your domain is
# verified in Resend, switch to a branded sender:
CONTACT_EMAIL_FROM=URBAN STAYS Website <onboarding@resend.dev>

# --- Option B: webhook (FormSubmit / Web3Forms / Make / Zapier) -------------
# If set (and RESEND_API_KEY is empty), every enquiry is POSTed as JSON here.
CONTACT_WEBHOOK_URL=
